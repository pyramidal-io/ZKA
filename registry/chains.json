{
  "version": "zka:registry:v1",
  "description": "Canonical ZKA chain / verifier / public-input encoding registry. Every live settlement adapter loads this registry (compiled into the zka-registry crate) and fails closed on any chain, verifier, or public-input metadata that does not match it. See docs/sdd/sdd_registry_encodings.md for the encoding annex.",
  "bridgeDomainRules": {
    "evm-abi-uint256-chain-id": {
      "description": "EVM settlement domains are bound by the chain id as a 32-byte big-endian ABI word: abi.encode(uint256(chainId)). This is the chain-id word of the ADR 0003 asset-id digest keccak256(abi.encode(uint256(chainId), address(token)))."
    },
    "aztec-portal-evm-binding": {
      "description": "Aztec withdrawals settle through an immutable per-asset L1 portal consuming the rollup Outbox: every L2->L1 message binds (l2Bridge actor, rollup version) as sender and (portalAddress, uint256(l1ChainId)) as recipient, with content = sha256ToField(selector ++ recipient ++ amount), so the Aztec domain is anchored to a registered eip155 chain plus the deployed portal/outbox addresses (contracts/ethereum/ZKAAztecPortal.sol)."
    }
  },
